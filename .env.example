# Copy to .env and adjust. The core platform runs with zero dependencies;
# these settings only affect the optional API service and the demo CLI.

# Directory the lakehouse tables are written to / read from.
LAKEHOUSE_ROOT=./lakehouse-data

# Topic the demo pipeline consumes.
LAKEHOUSE_TOPIC=orders

# In production this is where a real Kafka transport would be configured,
# e.g. KAFKA_BOOTSTRAP_SERVERS=broker-1:9092,broker-2:9092 — the pipeline
# only depends on the EventSource/EventSink protocols, so swapping the
# in-process bus for Kafka touches transport code only.
